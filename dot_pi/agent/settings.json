{
  "lastChangelogVersion": "1.6.1",
  "theme": "catppuccin-frappe",
  "packages": [
    "npm:pi-cursor-sdk",
    "npm:pi-btw",
    "npm:@tmustier/pi-usage-extension",
    "npm:@diegopetrucci/pi-context-inspector",
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "git:github.com/code-yeongyu/pi-rules",
    "npm:cc-safety-net",
    "npm:@sting8k/pi-vcc",
    "../../projects/pi-tmfv",
    "npm:pi-ask-user"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "defaultThinkingLevel": "high",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.4",
  "hideThinkingBlock": true,
  "subagents": {
    "defaultModel": "zai/glm-5.4",
    "agentOverrides": {
      "scout": {
        "model": "zai/glm-5.3-flash",
        "tools": [
          "read", "grep", "find", "ls", "bash", "write", "contact_supervisor",
          "mcp:postgres_production",
          "mcp:grafana"
        ],
        "excludeTools": [
          "grafana_add_activity_to_incident",
          "grafana_alerting_manage_routing",
          "grafana_alerting_manage_rules",
          "grafana_create_annotation",
          "grafana_create_folder",
          "grafana_create_incident",
          "grafana_update_annotation",
          "grafana_update_dashboard"
        ]
      },
      "researcher": {
        "model": "zai/glm-5.3-flash"
      },
      "worker": {
        "model": "zai/glm-5.4",
        "tools": [
          "read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor",
          "mcp:postgres_production",
          "mcp:grafana"
        ],
        "excludeTools": [
          "grafana_add_activity_to_incident",
          "grafana_alerting_manage_routing",
          "grafana_alerting_manage_rules",
          "grafana_create_annotation",
          "grafana_create_folder",
          "grafana_create_incident",
          "grafana_update_annotation",
          "grafana_update_dashboard"
        ]
      },
      "delegate": {
        "model": "zai/glm-5.4",
        "tools": [
          "read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor",
          "mcp:postgres_production",
          "mcp:grafana"
        ],
        "excludeTools": [
          "grafana_add_activity_to_incident",
          "grafana_alerting_manage_routing",
          "grafana_alerting_manage_rules",
          "grafana_create_annotation",
          "grafana_create_folder",
          "grafana_create_incident",
          "grafana_update_annotation",
          "grafana_update_dashboard"
        ]
      },
      "reviewer": {
        "model": "zai/glm-5.4",
        "thinking": "high"
      },
      "oracle": {
        "model": "zai/glm-5.4",
        "thinking": "high"
      }
    },
    "agentOverridesByProvider": {
      "cursor": {
        "scout": {
          "model": "cursor/composer-2.5"
        },
        "researcher": {
          "model": "cursor/grok-4.6"
        },
        "worker": {
          "model": "cursor/grok-4.6",
          "thinking": "high"
        },
        "delegate": {
          "model": "cursor/grok-4.6",
          "thinking": "high"
        },
        "reviewer": {
          "model": "cursor/grok-4.7",
          "thinking": "high"
        },
        "oracle": {
          "model": "cursor/grok-4.7@500k",
          "thinking": "high"
        }
      }
    }
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-cursor-sdk\",\"scope\":\"user\"}": "0.5.47",
    "{\"source\":\"npm:@tmustier/pi-ralph-wiggum\",\"scope\":\"user\"}": "0.2.5",
    "{\"source\":\"npm:@tmustier/pi-usage-extension\",\"scope\":\"user\"}": "0.10.2",
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.90.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"git:github.com/code-yeongyu/pi-rules\",\"scope\":\"user\"}": "0.2.0",
    "{\"source\":\"npm:@sting8k/pi-vcc\",\"scope\":\"user\"}": "0.12.1",
    "{\"source\":\"npm:@diegopetrucci/pi-context-inspector\",\"scope\":\"user\"}": "0.1.19"
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "notices": {
    "cacheMisses": true,
    "cacheWarming": true,
    "compactionCosts": true,
    "reasoningDrops": true
  }
}