[gitflow "feature.finish"]
	no-ff = true
[user]
	name = Ilya Timofeev
	email = me@tmfv.ru
[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global
[diff]
	tool = vimdiff
[merge]
	tool = codediff
	conflictStyle = zdiff3
[mergetool "vimdiff"]
  cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[pull]
	rebase = true
[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff --exit-on-close merge \\\"$MERGED\\\"\"
